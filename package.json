{
  "name": "tfila",
  "private": true,
  "version": "1.0.0",
  "description": "tfila — an interactive 3D universe of Jewish prayers (Hebrew, RTL)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "content": "node scripts/fetch-sources.mjs && node scripts/build-content.mjs",
    "test": "node scripts/validate-content.mjs",
    "test:e2e": "node tests/shots.mjs http://localhost:4173/ test-shots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
